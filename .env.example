# 当前按未部署项目准备，本地首次运行使用 development；以后正式使用再改为 production 并完成安全检查。
APP_ENV=development

# 数据库连接：首次启动自动建立空库和初始管理员；SQLite 相对路径固定以 StoreNet 根目录为准。
# 默认保存在 data/store-net.db，不读取根目录可能留下的旧 store-net.db；不要连接正式库或其他项目的库。
# MySQL 可改为 mysql+mysqlconnector://用户名:密码@主机:3306/空数据库名，需要提前创建空数据库。
DATABASE_URL=sqlite:///data/store-net.db

# 允许跨域访问后端的网站来源，多个用英文逗号分隔；包含协议和端口，不带路径，不使用通配符。
CORS_ORIGINS=http://localhost:8081

# 登录令牌签名密钥：替换为至少32位随机字符，不要沿用示例；更换后原登录令牌会失效。
TOKEN_SECRET=replace-with-at-least-32-random-characters

# 登录令牌有效期，单位为分钟；1440为一天，到期后需要重新登录。
TOKEN_TTL_MINUTES=1440

# 初始管理员用户名：只在该用户名不存在时创建账号，不会修改已有账号。
ADMIN_USERNAME=admin

# 初始管理员邮箱：首次创建账号时使用；更改配置不会更新已有账号的邮箱。
ADMIN_EMAIL=admin@example.com

# 初始管理员密码：首次创建时使用，务必替换示例；修改此项不能重置已有密码。
ADMIN_PASSWORD=replace-with-a-strong-password

# 头像等上传文件的保存目录；相对路径固定以 StoreNet 根目录为准，已有上传文件不会因初始化被清空。
UPLOAD_DIR=uploads

# 单次上传文件大小上限，单位为字节；2097152约为2 MiB。
MAX_UPLOAD_BYTES=2097152

# 上传图片总像素上限，即宽乘高；16000000为一千六百万像素，不是文件大小。
MAX_UPLOAD_PIXELS=16000000

# 是否允许真实通通锁请求，默认 false；区域自动发码还需单独开启，正式启用前必须完成HTTPS和真实门锁验收。
# 开启后同时运行授权提前续期和近期发码核对；关闭时后台不会请求通通锁。
TTLOCK_REAL_ENABLED=false

# 门锁数据加密主密钥：随机32字节的Base64编码，不是通通锁应用密钥；不启用门锁时可留空。
# 必须独立备份，不与ChipsNet共用；更换或丢失后，已有门锁密文将无法解密。
TTLOCK_MASTER_KEY=
